# API-Football (via RapidAPI o api-sports.io directo)
# Regístrate gratis en https://www.api-football.com/ o https://rapidapi.com/api-sports/api/api-football
API_FOOTBALL_KEY=

# 140 = LaLiga (España). Cambia si tu liga de Futmondo usa otra competición.
API_FOOTBALL_LEAGUE_ID=140

# Temporada como año de inicio (ej. temporada 2025/26 -> 2025). Déjalo vacío para autodetectar.
API_FOOTBALL_SEASON=

# --- Futmondo (API no oficial) ---
# Se capturan desde tu navegador ya logueado en Futmondo (ver README, sección
# "Importar tu plantilla real"). NUNCA compartas estos valores por chat/email.
FUTMONDO_TOKEN=
FUTMONDO_USER_ID=
FUTMONDO_CHAMPIONSHIP_ID=
FUTMONDO_TEAM_ID=
